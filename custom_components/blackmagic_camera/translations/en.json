          "host": "Host",
          "use_https": "Use HTTPS",
          "verify_ssl": "Verify SSL certificate",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or hostname of the camera, e.g. 192.168.1.50 or PYXIS-6K.local.",
          "use_https": "Turn on when web media manager is set to 'Enabled with security only'.",
          "verify_ssl": "Leave off for the camera's default self-signed certificate.",
          "username": "Only needed when secure login is set in Blackmagic Camera Setup.",
          "password": "Only needed when secure login is set in Blackmagic Camera Setup."
