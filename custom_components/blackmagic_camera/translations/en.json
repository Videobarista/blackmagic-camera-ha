  "issues": {
    "https_required": {
      "title": "{name}: camera only accepts HTTPS",
      "description": "The camera at {host} redirects to HTTPS: its web media manager is set to **Enabled with security only**. Home Assistant keeps checking.\n\nEither reconfigure this integration with **Use HTTPS** and the username and password set under Secure login in Blackmagic Camera Setup, or set **Web media manager** back to **Enabled**."
    },
    "api_unavailable": {
      "title": "{name}: camera REST API is switched off",
      "description": "The camera at {host} answers, but its REST API returns 404. Home Assistant keeps checking and recovers automatically once the API is back.\n\nIn Blackmagic Camera Setup → Network Access set **Web media manager** to **Enabled**. If you chose **Enabled with security only**, reconfigure this integration with **Use HTTPS** and the username and password from the camera."
    }
  }
